# Mistral hosted API (https://console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# Set to true to run without a Mistral key (returns a fake streamed reply)
MOCK_LLM=false

# CI4 endpoint that validates the user's token and returns their context.
# Leave empty to use DEMO_USER below (hackathon fallback).
CI4_WHOAMI_URL=
CI4_TIMEOUT_SECONDS=5

# Comma-separated origins allowed to call the gateway (your CI4 web app, local dev)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080

# Audit log (JSON lines). Moves to a DB table later.
AUDIT_LOG_PATH=logs/ai_interactions.jsonl
